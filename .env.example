# Copy to .env (git-ignored) and replace every CHANGE_ME. Never commit real values.
# Used by docker-compose.yml for LOCAL development only. In Azure the same values are
# Container Apps secrets / API Management Named Values (see docs/deployment.md).

# --- PostgreSQL (local container) ---
POSTGRES_PASSWORD=CHANGE_ME

# --- API ---
# Long random string (>= 32 chars). Signs/verifies the HS256 JWTs.
JWT_SECRET=CHANGE_ME
# Demo account passwords loaded by the seed script (students: username = student number; admin: "admin").
SEED_STUDENT_PASSWORD=CHANGE_ME
SEED_ADMIN_PASSWORD=CHANGE_ME
# Shared secret the API gateway adds as X-Gateway-Secret. Leave EMPTY locally (no gateway in compose);
# set it in the cloud so /api/v1 cannot be called around the gateway.
GATEWAY_SECRET=

# --- Agent ---
# Gemini API key (OpenAI-compatible endpoint). Keep it out of git; revoke it after grading.
GEMINI_API_KEY=CHANGE_ME
# Model used in the deployed demo (gemini-flash-latest hit 503 "high demand" during testing).
LLM_MODEL=gemini-3.5-flash-lite
# Cloud: https://<apim-name>.azure-api.net (no trailing slash, no /api/v1). Local compose: the API directly.
GATEWAY_URL=http://api:3000
# MCP server (Streamable HTTP endpoint)
MCP_URL=http://mcp:3100/mcp
# Shared secret between agent and MCP server (Bearer token). Empty = no check (local compose only).
# In Azure it is REQUIRED because the MCP app has external ingress (see docs/deployment.md).
MCP_AUTH_TOKEN=
