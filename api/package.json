{
  "name": "tuition-api",
  "version": "1.0.0",
  "description": "University Tuition REST API (v1) for the SE 4458 midterm",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node db/init.js",
    "db:seed": "node db/seed.js",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --config jest.integration.config.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/unit/**/*.test.js"
    ]
  }
}
